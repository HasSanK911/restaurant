{
  "name": "salateen-restaurant",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n api,web -c magenta,cyan \"npm:api\" \"ng serve\"",
    "serve": "ng serve",
    "api": "json-server db.json --port 3000",
    "seed": "node scripts/seed.mjs",
    "seed:reset": "node scripts/seed.mjs && echo db.json regenerated",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "node scripts/build.mjs",
    "build:only": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "build:laravel": "ng build --configuration laravel",
    "build:netlify": "node scripts/build.mjs --configuration netlify"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.6",
    "@netlify/blobs": "^10.7.12",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@netlify/angular-runtime": "^4.0.0",
    "@netlify/functions": "^5.3.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.15.0",
    "concurrently": "^10.0.4",
    "jsdom": "^28.0.0",
    "json-server": "^1.0.0-beta.15",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
